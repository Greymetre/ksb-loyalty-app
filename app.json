{
  "expo": {
    "name": "KSB-VRiDDHi",
    "slug": "ksb-retailer-app",
    "version": "2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fdf7ec"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fieldkonnect.ksbretailerapp",
      "icon": "./assets/icon.png",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt"
        ]
      }
    },
    "android": {
      "package": "com.fieldkonnect.vriddhiksb",
      "permissions": [
        "CAMERA"
      ],
      "versionCode": 9,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fdf6ea"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "KSB-VRiDDHi uses photo library access so you can select GST, PAN, Aadhaar and bank proof images for KYC verification.",
          "cameraPermission": "KSB-VRiDDHi uses the camera to capture GST, PAN, Aadhaar and bank proof documents for KYC verification."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "apiBaseUrl": "https://app.ksbindia.co.in/FieldKonnect_API/api"
    },
    "icon": "./assets/icon.png"
  }
}
