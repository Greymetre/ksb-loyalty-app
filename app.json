{
  "expo": {
    "name": "Vriddhi KSB",
    "slug": "ksb-retailer-app",
    "version": "1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fieldkonnect.ksbretailerapp"
    },
    "android": {
      "package": "com.fieldkonnect.vriddhiksb",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Vriddhi KSB uses photo library access so you can select GST, PAN, Aadhaar and bank proof images for KYC verification.",
          "cameraPermission": "Vriddhi KSB uses the camera to capture GST, PAN, Aadhaar and bank proof documents for KYC verification."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://app.ksbindia.co.in/FieldKonnect_API/api"
    }
  }
}
