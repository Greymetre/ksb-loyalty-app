<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Some Android versions ship a system trust store that predates the roots the
      API server's certificate chains to, so the path cannot be built from the
      system store alone. The server currently uses a GlobalSign Root R46 chain
      (added to Android only from API 34), which Android 13 and earlier do not
      trust, causing an SSLHandshakeException "Trust anchor for certification
      path not found". The Sectigo anchor is kept for older server certificates.
      Both anchors are scoped to the FieldKonnect API host.
    -->
    <domain-config>
        <domain includeSubdomains="false">app.ksbindia.co.in</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/globalsign_root_r46" />
            <certificates src="@raw/sectigo_public_server_authentication_ca_ov_r36" />
        </trust-anchors>
    </domain-config>
</network-security-config>
