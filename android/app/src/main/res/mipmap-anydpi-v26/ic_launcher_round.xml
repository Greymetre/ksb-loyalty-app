<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ masks the icon into whatever shape the launcher uses. Handing it a
     background and a foreground separately keeps the mark inside the safe area instead
     of letting a circular mask cut the wordmark off a flat square. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/iconBackground"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
