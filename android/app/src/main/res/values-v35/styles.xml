<resources>
  <!--
    Android 16 forces edge-to-edge on every app that targets API 36, which would
    push the app's own content under the status bar. The screens here are laid out
    against the system bars as they are, so the enforcement is opted out of and the
    app keeps looking exactly as it does today.

    This opt-out is honoured while the app targets 36; it stops working at 37, by
    which time the screens need real insets handling instead.
  -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:textColor">@android:color/black</item>
    <item name="android:editTextStyle">@style/ResetEditText</item>
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">#ffffff</item>
    <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
  </style>
</resources>
