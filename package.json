{
  "name": "ksb-retailer-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "start": "PATH=/opt/homebrew/opt/node@22/bin:$PATH expo start --host localhost --clear",
    "android": "PATH=/opt/homebrew/opt/node@22/bin:$PATH expo start --android --host localhost",
    "ios": "PATH=/opt/homebrew/opt/node@22/bin:$PATH expo start --ios --host localhost --clear",
    "web": "PATH=/opt/homebrew/opt/node@22/bin:$PATH expo start --web --host localhost",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "axios": "^1.7.9",
    "expo": "~52.0.25",
    "expo-asset": "~11.0.5",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "^0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "^15.15.5",
    "react-native-svg-transformer": "^1.5.3"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.3.3"
  }
}
